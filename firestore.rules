rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (request.auth.token.email == "yuniet2022@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email is string &&
             data.role in ["customer", "admin", "driver"];
    }

    function isAssignedDriver(data) {
      return data.deliveryInfo != null && data.deliveryInfo.assignedDriverId == request.auth.uid;
    }

    function isValidOrder(data) {
      return (data.userId == request.auth.uid || isAdmin()) &&
             data.total is number && data.total > 0 &&  
             data.items is list && data.items.size() > 0 &&
             data.status in ["pending", "pending_approval", "processing", "ready_for_pickup", "shipped", "out_for_delivery", "delivered", "cancelled"] &&
             data.orderType in ["instant", "scheduled"] &&
             (data.prescriptionStatus == null || data.prescriptionStatus in ["pending", "approved", "rejected"]) &&
             data.createdAt is string;
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId && isValidUser(request.resource.data) && request.resource.data.role == "customer";
      allow update: if isOwner(userId) && (
        request.resource.data.role == resource.data.role || isAdmin()
      ) && isValidUser(request.resource.data);
    }

    // Products
    match /products/{productId} {
      allow get: if true;
      allow list: if true;
      allow write: if isAdmin();
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Branding Config
    match /branding/{brandingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin() || isAssignedDriver(resource.data));
      allow list: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid || isAssignedDriver(resource.data));
      allow create: if isAuthenticated() && isValidOrder(request.resource.data);
      allow update: if isAdmin() || (
        isAuthenticated() && 
        isAssignedDriver(resource.data) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deliveryInfo'])
      );
      allow delete: if false; 
    }

    // Drivers
    match /drivers/{driverId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == driverId);
    }

    // Routes
    match /routes/{routeId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
